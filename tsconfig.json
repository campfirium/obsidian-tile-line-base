{
 "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2021",
    "allowJs": true,
    "noImplicitAny": true,
	"moduleResolution": "node",
	"resolveJsonModule": true,
	"esModuleInterop": true,
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
	"noUnusedLocals": true,
	"noUnusedParameters": true,
    "lib": [
      "ES2021",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ]
}
